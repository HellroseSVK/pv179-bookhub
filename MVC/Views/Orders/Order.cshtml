@using DataAccessLayer.Enums
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model MVC.Models.Order.OrderViewModel
@{
    ViewData["Title"] = "Order";
}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-9 col-lg-10">
            <h2 class="mb-3">Order @Model.Id details</h2>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            <div class="mb-3">
                @switch (Model.OrderStatus)
                {
                    case OrderStatus.Draft:
                        <span class="badge bg-warning text-dark">Pending</span>
                        break;
                    case OrderStatus.Completed:
                        <span class="badge bg-success">Completed</span>
                        break;
                    case OrderStatus.Cancelled:
                        <span class="badge bg-danger">Cancelled</span>
                        break;
                    default:
                        <span class="badge bg-secondary">Unknown</span>
                        break;
                }
            </div>
            <p class="mb-3">Total price: @Model.TotalPrice.ToString("C")</p>
            @if (Model.GiftCard != null)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">Gift card</h5>
                            <p class="card-text flex-grow-1">@Model.GiftCard.Title</p>
                            <div class="mt-auto">
                                <p class="card-text">
                                    <strong>Price: @Model.GiftCard.Price.ToString("C")</strong>
                                </p>
                                <p class="card-text">
                                    <strong>Code: @Model.GiftCard.GiftCode.Code</strong>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }
            @if (Model.Books.Count > 0)
            {
                <p class="text-muted">Showing @Model.Books.Count books</p>
                <div class="row">
                    @foreach (var book in Model.Books)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100">
                                @if (!string.IsNullOrEmpty(book.ImageUrl))
                                {
                                    <img src="@book.ImageUrl" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@book.Title"/>
                                }
                                else
                                {
                                    <div class="card-img-top d-flex align-items-center justify-content-center" style="height: 200px; background-color: #f8f9fa;">
                                        <span class="text-muted">No Image</span>
                                    </div>
                                }
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@book.Title</h5>
                                    <p class="card-text flex-grow-1">@book.Description</p>
                                    <div class="mt-auto">
                                        <p class="card-text">
                                            <strong>Price: @book.Price.ToString("C")</strong>
                                        </p>
                                        <a asp-controller="Search" asp-action="Index" method="get" asp-route-searchTerm="@book.Title" class="btn btn-sm btn-primary">
                                            View
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h4>No books found</h4>
                </div>
            }
        </div>
    </div>
</div>