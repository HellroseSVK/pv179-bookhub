@using Microsoft.AspNetCore.Mvc.TagHelpers
@model MVC.Models.Book.BookUpsertViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit Book" : "Create Book";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="BookUpsert" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-8">
                <!-- Title -->
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="Enter book title" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Price -->
                <div class="mb-3">
                    <label asp-for="Price" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" />
                    </div>
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <!-- Publisher -->
                <div class="mb-3">
                    <label asp-for="SelectedPublisherId" class="form-label"></label>
                    <select asp-for="SelectedPublisherId" asp-items="Model.Publishers" class="form-select">
                        <option value="">-- Select Publisher --</option>
                    </select>
                    <span asp-validation-for="SelectedPublisherId" class="text-danger"></span>
                </div>

                <!-- Primary Genre -->
                <div class="mb-3">
                    <label asp-for="SelectedPrimaryGenreId" class="form-label"></label>
                    <select asp-for="SelectedPrimaryGenreId" asp-items="Model.Genres" class="form-select">
                        <option value="">-- Select Primary Genre --</option>
                    </select>
                    <span asp-validation-for="SelectedPrimaryGenreId" class="text-danger"></span>
                    <small class="form-text text-muted">Primary genre is displayed prominently.</small>
                </div>

                <!-- Secondary Genres -->
                <div class="mb-3">
                    <label asp-for="SelectedSecondaryGenreIds" class="form-label"></label>
                    <div class="border rounded p-2" style="max-height: 200px; overflow-y: auto; background-color: #fff;">
                        @if (Model.Genres.Any())
                        {
                            @foreach (var genre in Model.Genres)
                            {
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="SelectedSecondaryGenreIds"
                                           value="@genre.Value"
                                           id="genre_@genre.Value"
                                           @(Model.SelectedSecondaryGenreIds.Contains(int.Parse(genre.Value)) ? "checked" : "") />
                                    <label class="form-check-label" for="genre_@genre.Value">
                                        @genre.Text
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">No genres available</p>
                        }
                    </div>
                    <small class="form-text text-muted">Click to select multiple genres.</small>
                </div>

                <!-- Authors -->
                <div class="mb-3">
                    <label asp-for="SelectedAuthorIds" class="form-label"></label>
                    <div class="border rounded p-2" style="max-height: 200px; overflow-y: auto; background-color: #fff;">
                        @if (Model.Authors.Any())
                        {
                            @foreach (var author in Model.Authors)
                            {
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="SelectedAuthorIds"
                                           value="@author.Value"
                                           id="author_@author.Value"
                                           @(Model.SelectedAuthorIds.Contains(int.Parse(author.Value)) ? "checked" : "") />
                                    <label class="form-check-label" for="author_@author.Value">
                                        @author.Text
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">No authors available</p>
                        }
                    </div>
                    <small class="form-text text-muted">Click to select multiple authors.</small>
                </div>

                <!-- Image Upload -->
                <div class="mb-3">
                    <label asp-for="ImageFile" class="form-label"></label>
                    <input asp-for="ImageFile" class="form-control" type="file"
                           accept="image/png,image/jpeg,image/jpg,image/gif" />
                    <small class="form-text text-muted">Accepted: PNG, JPEG, JPG, GIF. Max: 10MB.</small>
                </div>

                <!-- Buttons -->
                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">
                        @(Model.Id.HasValue ? "Update Book" : "Create Book")
                    </button>
                    <a asp-action="Books" class="btn btn-secondary">Cancel</a>
                </div>
            </div>

            <!-- Image Preview Column -->
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header"><h5 class="mb-0">Book Cover Preview</h5></div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.CurrentImageUrl))
                        {
                            <img src="@Model.CurrentImageUrl" class="img-fluid rounded" alt="Current cover" />
                            <p class="text-muted mt-2 small">Upload new file to replace.</p>
                        }
                        else
                        {
                            <div class="text-center p-5 bg-light rounded">
                                <p class="text-muted">No image uploaded</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
