@using DataAccessLayer.Enums
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model MVC.Models.Order.OrderUpsertViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit Order" : "Create Order";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="OrderUpsert" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-8">
                <input asp-for="UserEmail" type="hidden"/>
                <!-- Gift Code -->
                <div class="mb-3">
                    <label asp-for="GiftCode" class="form-label"></label>
                    <input asp-for="GiftCode" class="form-control" placeholder="Enter gift code"/>
                    <span asp-validation-for="GiftCode" class="text-danger"></span>
                </div>

                <!-- Books -->
                <div class="mb-3">
                    <label asp-for="SelectedBookIds" class="form-label"></label>
                    <div class="border rounded p-2" style="max-height: 200px; overflow-y: auto; background-color: #fff;">
                        @if (Model.Books.Any())
                        {
                            @foreach (var genre in Model.Books)
                            {
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="SelectedBookIds"
                                           value="@genre.Value"
                                           id="genre_@genre.Value"
                                           @(Model.SelectedBookIds.Contains(int.Parse(genre.Value)) ? "checked" : "")/>
                                    <label class="form-check-label" for="genre_@genre.Value">
                                        @genre.Text
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">No books available</p>
                        }
                    </div>
                    <small class="form-text text-muted">Click to select multiple books.</small>
                </div>

                <!-- Order Status -->
                <div class="mb-3">
                    <label asp-for="OrderStatus" class="form-label"></label>
                    <select asp-for="OrderStatus" asp-items="Html.GetEnumSelectList<OrderStatus>()" class="form-select">
                        <option value="">-- Select Order Status --</option>
                    </select>
                    <span asp-validation-for="OrderStatus" class="text-danger"></span>
                    <small class="form-text text-muted">Order status for the order.</small>
                </div>

                <!-- Buttons -->
                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">
                        @(Model.Id.HasValue ? "Update Order" : "Create Order")
                    </button>
                    <a asp-action="Orders" asp-route-email="@(Model.UserEmail)" class="btn btn-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}