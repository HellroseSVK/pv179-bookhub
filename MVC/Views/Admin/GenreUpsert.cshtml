@using Microsoft.AspNetCore.Mvc.TagHelpers
@model MVC.Models.Genre.GenreUpsertViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit Genre" : "Create Genre";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="GenreUpsert" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-8">
                <!-- Name -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="Enter genre name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Books -->
                <div class="mb-3">
                    <label asp-for="SelectedBooksIds" class="form-label"></label>
                    <div class="border rounded p-2" style="max-height: 200px; overflow-y: auto; background-color: #fff;">
                        @if (Model.Books.Any())
                        {
                            @foreach (var book in Model.Books)
                            {
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="SelectedBooksIds"
                                           value="@book.Value"
                                           id="genre_@book.Value"
                                           @(Model.SelectedBooksIds.Contains(int.Parse(book.Value)) ? "checked" : "") />
                                    <label class="form-check-label" for="genre_@book.Value">
                                        @book.Text
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">No <books></books> available</p>
                        }
                    </div>
                    <small class="form-text text-muted">Click to select multiple genres.</small>
                </div>

                <!-- Buttons -->
                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">
                        @(Model.Id.HasValue ? "Update Genre" : "Create Genre")
                    </button>
                    <a asp-action="Genres" class="btn btn-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
