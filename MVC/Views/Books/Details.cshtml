@model MVC.Models.Book.BookDetailsViewModel
@{
    ViewData["Title"] = Model.Book.Title;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="row gy-4">
                <div class="col-md-5 col-lg-4">
                    <div class="card">
                        @if (!string.IsNullOrEmpty(Model.Book.ImageUrl))
                        {
                            <img src="@Model.Book.ImageUrl" class="card-img-top" style="width:100%; max-height:520px; object-fit:cover;" alt="@Model.Book.Title" />
                        }
                        else
                        {
                            <div class="card-img-top d-flex align-items-center justify-content-center" style="height:520px; background-color: #f8f9fa;">
                                <span class="text-muted">No Image</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-7 col-lg-8">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h2 class="card-title">@Model.Book.Title</h2>

                            <p class="card-text mb-1"><strong>Authors:</strong> @string.Join(", ", Model.Book.Authors.Select(a => $"{a.Name} {a.Surname}"))</p>
                            <p class="card-text mb-1"><strong>Genres:</strong> @string.Join(", ", Model.Book.Genres.Select(g => g.Name))</p>
                            <p class="card-text mb-1"><strong>Publisher:</strong> @Model.Book.Publisher?.Name</p>

                            <div class="mt-3 mb-3">
                                <span class="h4">@Model.Book.Price.ToString("C")</span>
                            </div>

                            @if (User.Identity!.IsAuthenticated)
                            {
                                <div class="mt-auto">
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mb-2">
                                        <input type="hidden" name="bookId" value="@Model.Book.Id" />
                                        <button type="submit" class="btn btn-primary btn-sm w-100">Add to Cart</button>
                                    </form>
                                    <form asp-controller="Wishlists" asp-action="AddToWishlist" method="post" class="mb-2">
                                        <input type="hidden" name="bookId" value="@Model.Book.Id" />
                                        <button type="submit" class="btn btn-primary btn-sm w-100">Add to Wishlist</button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12">
                    <div class="card mb-3">
                        <div class="card-header">Description</div>
                        <div class="card-body">
                            <p>@Model.Book.Description</p>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header">Reviews (@Model.Reviews.Count)</div>
                        <div class="card-body">
                            @if (!Model.Reviews.Any())
                            {
                                <p class="text-muted">No reviews yet.</p>
                            }
                            else
                            {
                                foreach (var review in Model.Reviews)
                                {
                                    <div class="mb-3">
                                        <div>
                                            @* Render stars using Unicode characters *@
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <span class="text-warning" aria-hidden="true">&#9733;</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted" aria-hidden="true">&#9734;</span>
                                                }
                                            }
                                            <small class="text-muted ms-2">@review.Rating/5</small>
                                        </div>
                                        <p class="mt-2">@review.Body</p>
                                    </div>
                                    <hr />
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
